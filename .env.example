# Copier ce fichier en .env.local et remplir les valeurs

# --- Build-time (injecté dans le bundle client) ---
# Domaine de base de l'application (sans protocole, sans port)
# Dev local  : learneo.local
# Staging    : learneo.dev-test2.nacre-solutions.com
# Production : learneo.example.com
NEXT_PUBLIC_BASE_DOMAIN=learneo.local

# Clé publique de l'app Reverb — doit correspondre à REVERB_APP_KEY côté backend.
# Utilisée par Echo/pusher-js pour la WebSocket temps réel (suivi SCORM, révocation
# de session).
#
# ATTENTION : ne PAS définir NEXT_PUBLIC_REVERB_HOST / _PORT. src/shared/lib/echo.ts
# retombe alors sur window.location.hostname + 443, et Caddy proxifie /app/* vers
# Reverb (voir .docker/caddy/Caddyfile). Les renseigner casse la connexion :
#   - `reverb` est un hostname Docker interne, irrésoluble depuis un navigateur
#   - le port 8080 n'est pas publié
#   - figer le domaine apex empêche chaque tenant d'utiliser son sous-domaine
#
# ATTENTION (2) : .dockerignore exclut .env*, donc `next build` dans l'image ne lit
# JAMAIS ce fichier. Pour un build d'image, ces valeurs doivent passer par
# build.args → ARG/ENV dans le Dockerfile (stage `builder`). En dev (target: dev,
# `next dev` sur le volume monté), .env.local est lu normalement.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_SCHEME=https

# --- Runtime serveur (lus par le proxy pages/api/[...learneo].ts) ---
# URL du backend depuis le container Next.js
# IMPORTANT : en Docker, utiliser host.docker.internal plutôt que localhost
# Dev local (hors Docker) : https://localhost:8443
# Docker                  : https://host.docker.internal:8443
BACKEND_BASE=https://host.docker.internal:8443

# Désactiver la vérification TLS en développement (mettre à 1 pour ignorer les certs auto-signés)
INSECURE_TLS=0
# api key de LocationIQ pour la recherche de localisation
NEXT_PUBLIC_LOCATIONIQ_API_KEY=