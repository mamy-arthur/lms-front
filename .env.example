# Copier ce fichier en .env.local et remplir les valeurs

# --- Build-time (injecté dans le bundle client) ---
# Domaine de base de l'application (sans protocole, sans port)
# Dev local  : learneo.local
# Staging    : learneo.dev-test2.nacre-solutions.com
# Production : learneo.example.com
NEXT_PUBLIC_BASE_DOMAIN=learneo.local

# --- Runtime serveur (lus par le proxy pages/api/[...learneo].ts) ---
# URL du backend depuis le container Next.js
# IMPORTANT : en Docker, utiliser host.docker.internal plutôt que localhost
# Dev local (hors Docker) : https://localhost:8443
# Docker                  : https://host.docker.internal:8443
BACKEND_BASE=https://host.docker.internal:8443

# Désactiver la vérification TLS en développement (mettre à 1 pour ignorer les certs auto-signés)
INSECURE_TLS=0
# api key de LocationIQ pour la recherche de localisation
NEXT_PUBLIC_LOCATIONIQ_API_KEY=
# Laravel Reverb — WebSocket (session revocation)
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=learneo.local
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https